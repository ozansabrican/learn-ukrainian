# Copy to .env and adjust. Paths are relative to the server/ folder.
PORT=3000
HOST=127.0.0.1

# Where progress is stored:
#   file → JSON files in DATA_DIR (default locally, no Vercel needed)
#   blob → Vercel Blob (default on Vercel). To use it locally, run
#          `vercel env pull .env` to get BLOB_READ_WRITE_TOKEN.
STORAGE=file
DATA_DIR=data
# BLOB_READ_WRITE_TOKEN=
# Prefix for blob paths, e.g. dev/ so local testing doesn't touch real profiles
# BLOB_PREFIX=dev/

# Folder containing index.html (served at / during local dev)
WEB_ROOT=..
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
LOG_LEVEL=info
